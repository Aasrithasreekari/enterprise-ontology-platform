# Copy to .env (never commit .env):  Copy-Item .env.example .env
# Values are read by `podman compose` and by the app (OP_* variables) when run locally.

# --- PostgreSQL (compose) ---
POSTGRES_USER=ontology
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ontology

# --- Published ports (bound to 127.0.0.1) ---
OP_API_PORT=8000
OP_MCP_PORT=8001
OP_IMAGE_TAG=0.1.0

# --- Application ---
OP_LOG_LEVEL=INFO
OP_LOG_JSON=true
OP_ENVIRONMENT=local
# Local (non-container) runs use SQLite by default:
# OP_DATABASE_URL=sqlite:///./ontology.db

# Optional: verify JWTs from your IdP (HS256 secret of >= 32 chars, or RS256 public key PEM)
OP_JWT_KEY=
OP_JWT_AUDIENCE=
OP_JWT_ISSUER=
OP_JWT_ALGORITHM=HS256

# Database connection pool (PostgreSQL)
OP_DB_POOL_SIZE=10
OP_DB_MAX_OVERFLOW=10
OP_DB_POOL_TIMEOUT_SECONDS=30

# Agent workflow limits
OP_AGENT_STEP_TIMEOUT_SECONDS=20
OP_AGENT_MAX_RETRIES=1
OP_AGENT_MAX_PARALLEL=4
OP_AGENT_MAX_STEPS=12

# MCP stdio transport only: API key the local agent acts as
# OP_MCP_API_KEY=op_xxx_yyy

# Connector secrets are referenced by connectors as env:NAME, e.g.
# GITHUB_TOKEN=
# CONFLUENCE_CREDENTIALS=me@example.com:api-token

# --- PuppyGraph PoC overlay (poc/puppygraph/compose.puppygraph.yaml) ---
PUPPYGRAPH_PASSWORD=change-me-local-only
# password of the read-only PostgreSQL role PuppyGraph connects with
PUPPYGRAPH_PG_PASSWORD=change-me-local-only
# PUPPYGRAPH_TAG=1.19.0
